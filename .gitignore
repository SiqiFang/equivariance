# Strict whitelist: only the released code is tracked.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/moment_kernels.py
!/classification/
/classification/*
!/classification/benchmark_train.py
!/classification/benchmark_eval.py
!/classification/pcam_dataset.py
!/classification/eval_sreconv_published.py
!/classification/train_sreconv_published.sh
!/classification/models/
/classification/models/*
!/classification/models/__init__.py
!/classification/models/benchmark_models2.py
!/classification/models/E2CNN_models.py
!/registration/
/registration/*
!/registration/mri_common.py
!/registration/mri_train.py
!/registration/mri_eval.py
!/registration/models/
/registration/models/*
!/registration/models/__init__.py
!/registration/models/escnn3d.py
!/registration/models/mri_synthmorph.py
# Never commit artifacts, data, or caches
__pycache__/
*.pyc
*.pt
*.ckpt
*.npz
*.h5
*.pdf
*.zip
.DS_Store
